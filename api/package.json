{
  "name": "projectzamin-backend",
  "version": "1.0.0",
  "description": "projectZamin Backend API",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0",
    "yarn": "please-use-pnpm",
    "npm": "please-use-pnpm",
    "pnpm": ">=10.11.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --exec tsx src/index.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "build": "rm -rf ./dist && tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:watch": "vitest --watch src",
    "test:coverage": "vitest run --coverage src",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "clean:find-unused": "knip",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "src/**/*.ts": "eslint --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@scalar/express-api-reference": "^0.10.7",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.23",
    "bullmq": "^5.79.2",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.16.0",
    "mongodb": "^7.4.0",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "resend": "^6.16.0",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@faker-js/faker": "^10.5.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "knip": "^6.23.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.4",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
