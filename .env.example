# projectZamin monorepo — copy to `.env` at repo root
#   cp .env.example .env
#   cp app/.env.example app/.env.local
#   pnpm db:up && pnpm dev:api & pnpm dev:app

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
COOKIE_DOMAIN=localhost
DEVICE_ID=laptop-1
TRUST_PROXY_HOPS=0
# CORS_ORIGINS=http://localhost:3000

# Frontend (also copy NEXT_PUBLIC_* into app/.env.local for Next)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis-password

# Mongo
MONGO_INITDB_DATABASE=projectzamin
MONGO_INITDB_ROOT_USERNAME=projectzamin
MONGO_INITDB_ROOT_PASSWORD=changeme-mongo-password
MONGODB_URI=mongodb://projectzamin:changeme-mongo-password@localhost:27017/projectzamin?authSource=admin

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=projectzamin-files
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=changeme-minio-secret
MINIO_FORCE_PATH_STYLE=true
MINIO_PRESIGN_UPLOAD_EXPIRES_SECONDS=900
MINIO_PRESIGN_DOWNLOAD_EXPIRES_SECONDS=300

# Resilience & timeouts
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
S3_OPERATION_TIMEOUT_MS=15000
HTTP_CLIENT_TIMEOUT_MS=10000
IDEMPOTENCY_TTL_SECONDS=86400
AUDIT_LOGGING_DISABLED=false

INTERNAL_API_TOKEN=

# Email — EMAIL_PROVIDER: auto | resend | nodemailer
EMAIL_PROVIDER=auto
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=projectZamin <noreply@projectzamin.local>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=projectZamin

# Auth — email/password only (no OAuth)
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret
# BETTER_AUTH_SECRETS=1:old-secret,2:new-secret
BETTER_AUTH_URL=http://localhost:3001

# Admin seed (skip if any admin already exists)
ADMIN_EMAIL=admin@projectzamin.local
ADMIN_PASSWORD=changeme-admin-password
ADMIN_NAME=Admin

# Staff import
WARN_MULTIPLE_TEHSILDAR=true
# When true, import + password reset email temp credentials (requires EMAIL_PROVIDER)
INVITE_EMAIL_ENABLED=false
