NODE_ENV=test
PORT=3001
LOG_LEVEL=error
DEVICE_ID=laptop-test
TRUST_PROXY_HOPS=0

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis-password

MONGO_INITDB_DATABASE=projectzamin_test
MONGO_INITDB_ROOT_USERNAME=projectzamin
MONGO_INITDB_ROOT_PASSWORD=changeme-mongo-password
MONGODB_URI=mongodb://projectzamin:changeme-mongo-password@localhost:27017/projectzamin_test?authSource=admin

MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=projectzamin-files
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_FORCE_PATH_STYLE=true
MINIO_PRESIGN_UPLOAD_EXPIRES_SECONDS=900
MINIO_PRESIGN_DOWNLOAD_EXPIRES_SECONDS=300

REQUEST_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
S3_OPERATION_TIMEOUT_MS=15000
HTTP_CLIENT_TIMEOUT_MS=10000
IDEMPOTENCY_TTL_SECONDS=86400
AUDIT_LOGGING_DISABLED=true

BETTER_AUTH_SECRET=test-better-auth-secret-min-32-chars!!
BETTER_AUTH_URL=http://localhost:3001
EMAIL_PROVIDER=auto
