{
  "name": "projectzamin",
  "version": "1.0.0",
  "private": true,
  "description": "projectZamin monorepo — Next.js app + Express API",
  "engines": {
    "node": ">=20.0.0",
    "yarn": "please-use-pnpm",
    "npm": "please-use-pnpm",
    "pnpm": ">=10.11.0"
  },
  "scripts": {
    "dev": "pnpm run dev:api & pnpm run dev:app",
    "dev:api": "pnpm --filter projectzamin-backend dev",
    "dev:app": "pnpm --filter projectzamin-frontend dev",
    "build": "pnpm run build:api && pnpm run build:app",
    "build:api": "pnpm --filter projectzamin-backend build",
    "build:app": "pnpm --filter projectzamin-frontend build",
    "check:api": "pnpm --filter projectzamin-backend check",
    "db:up": "docker compose up -d",
    "db:up:vps": "docker compose -f docker-compose.yml -f docker-compose.vps.yml up -d",
    "db:up:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "db:down": "docker compose down",
    "db:down:prod": "docker compose -f docker-compose.prod.yml down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "api/src/**/*.ts": "pnpm --filter projectzamin-backend exec eslint --fix"
  }
}
