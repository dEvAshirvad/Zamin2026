# =============================================================================
# projectZamin — VPS / Coolify production env
# =============================================================================
# WHERE TO PASTE
#   1) On the VPS, next to docker-compose.prod.yml:
#        cp .env.production.example .env
#        nano .env          # fill REPLACE_* and secrets
#   2) Coolify → your Compose resource → Environment Variables
#        paste the same keys (Coolify injects them; still keep a server .env
#        if you run compose by hand)
#
# DO NOT commit the filled `.env`.
# Replace every REPLACE_* and every changeme-* before first boot.
# =============================================================================

NODE_ENV=production
PORT=3001
LOG_LEVEL=info
DEVICE_ID=vps-zamin-1

# --- Public URLs (Coolify SSL domains) ---
# App A-record you set: zamin.<YOUR_ZONE> → VPS IP
# Also add:          api.zamin.<YOUR_ZONE> → same IP
NEXT_PUBLIC_API_URL=https://api.zamin.REPLACE_ZONE
BETTER_AUTH_URL=https://api.zamin.REPLACE_ZONE
CORS_ORIGINS=https://zamin.REPLACE_ZONE
COOKIE_DOMAIN=.zamin.REPLACE_ZONE
TRUST_PROXY_HOPS=1

# --- Auth (required in production; secret ≥ 32 chars) ---
BETTER_AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# --- Admin seed (created once if no admin exists) ---
ADMIN_EMAIL=admin@REPLACE_ZONE
ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD
ADMIN_NAME=Admin

# --- Redis (container talks via Docker DNS; password required) ---
REDIS_HOST=redis_container
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis-password

# --- Mongo (compose overrides URI host to mongodb_container) ---
MONGO_INITDB_DATABASE=projectzamin
MONGO_INITDB_ROOT_USERNAME=projectzamin
MONGO_INITDB_ROOT_PASSWORD=changeme-mongo-password
# Used by tools / docs; api service overrides host to mongodb_container
MONGODB_URI=mongodb://projectzamin:changeme-mongo-password@mongodb_container:27017/projectzamin?authSource=admin

# --- MinIO (api uses http://minio:9000 via compose override) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=projectzamin-files
MINIO_ACCESS_KEY_ID=zaminminio
MINIO_SECRET_ACCESS_KEY=changeme-minio-secret
MINIO_FORCE_PATH_STYLE=true
MINIO_PRESIGN_UPLOAD_EXPIRES_SECONDS=900
MINIO_PRESIGN_DOWNLOAD_EXPIRES_SECONDS=300

# --- Ops ---
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
S3_OPERATION_TIMEOUT_MS=15000
HTTP_CLIENT_TIMEOUT_MS=10000
IDEMPOTENCY_TTL_SECONDS=86400
AUDIT_LOGGING_DISABLED=false
INTERNAL_API_TOKEN=
WARN_MULTIPLE_TEHSILDAR=true
INVITE_EMAIL_ENABLED=false
EMAIL_PROVIDER=auto

# --- Host publish map (reference only; set in docker-compose.prod.yml) ---
# UI:            127.0.0.1:7854  → Coolify proxies https://zamin.REPLACE_ZONE
# API:           127.0.0.1:7855  → Coolify proxies https://api.zamin.REPLACE_ZONE
# Mongo tunnel:  127.0.0.1:27027
# Redis tunnel:  127.0.0.1:6389
# MinIO API:     127.0.0.1:9100
# MinIO console: 127.0.0.1:9101
# Databasus:     127.0.0.1:4105
